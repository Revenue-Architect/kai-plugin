# Local defaults are intentionally loopback-only.
HOST=127.0.0.1
PORT=8787
MCP_TRANSPORT=http

# Raise only when your deployment needs larger JSON-RPC requests.
MAX_JSON_BODY_BYTES=2000000

# Set this to the HTTPS origin serving the ChatGPT widget in a public deployment.
UI_DOMAIN=https://kai-commerce-agent.netlify.app

# OAuth 2.1 protected-resource metadata for ChatGPT and other MCP hosts.
# Keep the resource identifier exactly equal to the deployed /mcp URL.
MCP_RESOURCE_URL=https://kai-commerce-agent.netlify.app/mcp
MCP_OAUTH_RESOURCE_METADATA_URL=https://kai-commerce-agent.netlify.app/.well-known/oauth-protected-resource
MCP_RESOURCE_DOCUMENTATION=https://github.com/Revenue-Architect/kai-plugin

# KaizenOS Supabase OAuth 2.1 issuer and signing keys.
KAIZEN_OAUTH_AUTH_SERVER=https://zovuwpfbsmnzgfkgxxpp.supabase.co/auth/v1
KAIZEN_OAUTH_ISSUER=https://zovuwpfbsmnzgfkgxxpp.supabase.co/auth/v1
KAIZEN_OAUTH_JWKS_URI=https://zovuwpfbsmnzgfkgxxpp.supabase.co/auth/v1/.well-known/jwks.json
KAIZEN_OAUTH_AUDIENCE=authenticated
KAIZEN_OAUTH_SCOPES=openid,email,profile,offline_access

# KaizenOS named CRM and project-management adapter.
# The endpoint is public infrastructure; the bearer token is not.
KAIZENOS_MCP_URL=https://zovuwpfbsmnzgfkgxxpp.supabase.co/functions/v1/agent-mcp

# Local stdio only: set a personal kai_... key or a private shared MCP token.
# Never commit or paste the value into plugin files, prompts, or widget payloads.
# KAIZENOS_MCP_BEARER_TOKEN=

# Hosted requests require caller authentication. Keep this false unless the
# deployment is private and you intentionally use one shared server identity.
# KAIZENOS_ALLOW_SERVER_WRITES=false
